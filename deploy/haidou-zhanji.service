[Unit]
Description=Haidou Zhanji multiplayer game
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=haidou
Group=haidou
WorkingDirectory=/opt/haidou-zhanji
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=ROOM_DATA_DIR=/var/lib/haidou-zhanji/rooms
ExecStart=/usr/bin/node /opt/haidou-zhanji/server/index.js
Restart=on-failure
RestartSec=3
StateDirectory=haidou-zhanji
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/haidou-zhanji
MemoryMax=768M

[Install]
WantedBy=multi-user.target
